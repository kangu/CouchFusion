# /etc/caddy/sites/radustanciu.caddy — edited by hand (spec §7.3); the control plane never touches Caddy.
# Behind Cloudflare's proxy with SSL mode "Full": Caddy's own self-signed certificate
# (tls internal) on the origin, Cloudflare's certificate to visitors.
radustanciu.ro {
	tls internal
	encode zstd gzip
	reverse_proxy 127.0.0.1:4501
}

www.radustanciu.ro, radustanciu.com, www.radustanciu.com {
	tls internal
	redir https://radustanciu.ro{uri} permanent
}

admin.radustanciu.ro {
	tls internal

	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @not_cloudflare

	# Present on every request Access let through. Presence only: verifying the token's signature
	# needs the app-side check (not built yet).
	@no_access_token not header Cf-Access-Jwt-Assertion *
	respond @no_access_token 403

	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip

	reverse_proxy 127.0.0.1:4502 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Url-Scheme {scheme}
		header_up X-Real-IP {remote_host}
	}
}
