# /etc/systemd/system/cf-registry@.service — CouchFusion component registry rebuild (Phase 2).
# Started by couchfusion-server (as cfcp, through polkit) for "Rebuild registry" and as the
# fallback when the dev server's registry watcher does not update in time. Repository code
# (the layer's generator) runs as cfdev, never as cfcp.
[Unit]
Description=CouchFusion component registry rebuild (%i)
After=couchfusion-nft.service
Requires=couchfusion-nft.service

[Service]
Type=oneshot
User=cfdev
Group=cfdev
SupplementaryGroups=cfsrc
Slice=couchfusion.slice
UMask=0002
WorkingDirectory=/srv/couchfusion/workspace
Environment=HOME=/var/lib/cfdev
Environment=PATH=/opt/couchfusion/toolchain/bin:/usr/bin:/bin
ExecStart=/opt/couchfusion/toolchain/bin/bun /srv/couchfusion/workspace/layers/content/scripts/generate-component-registry.mjs --app=%i
TimeoutStartSec=120
MemoryMax=512M
CPUQuota=100%
Nice=10

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
# The generator needs no network at all.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
ReadWritePaths=/srv/couchfusion/workspace/apps/%i /var/lib/cfdev
InaccessiblePaths=-/srv/couchfusion/workspace/apps/%i/.git -/srv/couchfusion/workspace/layers/.git -/srv/couchfusion/workspace/cli-content/.git
InaccessiblePaths=-/etc/couchfusion -/var/lib/couchfusion -/var/lib/cfagent -/etc/caddy -/var/www
